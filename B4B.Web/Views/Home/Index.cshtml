@model CompanyConfigViewModel

@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="py-4">
    <h1 class="mb-3">Ana Sayfa</h1>

    @if (Model.Success)
    {
        <dl class="row">
            <dt class="col-sm-3">Firma ID</dt>
            <dd class="col-sm-9">@Model.CompanyId</dd>

            <dt class="col-sm-3">Firma Adı</dt>
            <dd class="col-sm-9">@Model.CompanyName</dd>

            <dt class="col-sm-3">Config Değeri</dt>
            <dd class="col-sm-9">@Model.ConfigValue</dd>
        </dl>
    }
    else
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }
</div>
