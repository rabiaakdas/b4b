@model AdminPanelViewModel

@{
    ViewData["Title"] = "Yönetim Paneli";
}

<div class="py-4">
    <h1 class="mb-3">Yönetim Paneli</h1>

    <dl class="row">
        <dt class="col-sm-3">Firma</dt>
        <dd class="col-sm-9">@Model.CompanyName</dd>

        <dt class="col-sm-3">Kullanıcı</dt>
        <dd class="col-sm-9">@Model.Username</dd>
    </dl>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Users">Kullanıcılar</a>
        <a class="btn btn-outline-primary" asp-action="Orders">Siparişler</a>
    </div>
</div>
